<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ui"
    xmlns:controls="using:PalmierPro.UI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#121214">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="300" />
            <RowDefinition Height="5" />
            <RowDefinition Height="2*" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- TOP PANEL: Sidebar & Player -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Media Sidebar -->
            <Grid Grid.Column="0" Background="#1A1A1E" Margin="10,10,5,5" CornerRadius="8" BorderThickness="1" BorderBrush="#2D2D32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Media Browser" FontWeight="Bold" FontSize="16" Foreground="#E1E1E6" Margin="15,15,15,10" />
                
                <ListView Grid.Row="1" x:Name="MediaListView" SelectionMode="None" Margin="5,0,5,10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" Margin="5" Background="#242428" CornerRadius="6" BorderThickness="1" BorderBrush="#323238">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#3A86FF" FontSize="20" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#E1E1E6" />
                                    <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="#8E8E9F" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Column Splitter -->
            <toolkit:GridSplitter Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch" />

            <!-- Player Monitor -->
            <Grid Grid.Column="2" Background="#1A1A1E" Margin="5,10,10,5" CornerRadius="8" BorderThickness="1" BorderBrush="#2D2D32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Monitor viewport -->
                <Grid Grid.Row="0" Background="#0C0C0E" Margin="15,15,15,10" CornerRadius="6" BorderThickness="1" BorderBrush="#28282C">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="#4E4E54" />
                        <TextBlock Text="Palmier Player Monitor" FontSize="15" FontWeight="SemiBold" Foreground="#4E4E54" />
                        <TextBlock x:Name="PlayheadTimecode" Text="00:00:00.00" FontSize="13" Foreground="#8E8E9F" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Controls Bar -->
                <Grid Grid.Row="1" Padding="15,5,15,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                        <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="#E1E1E6" FontSize="16" Click="OnPrevFrameClick" />
                        <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Background="#3A86FF" BorderThickness="0" CornerRadius="18" Width="36" Height="36" Foreground="White" FontSize="14" Click="OnPlayClick" />
                        <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="#E1E1E6" FontSize="16" Click="OnNextFrameClick" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Zoom" FontSize="11" Foreground="#8E8E9F" VerticalAlignment="Center" />
                        <Slider x:Name="ZoomSlider" Width="100" Minimum="0.1" Maximum="10.0" StepFrequency="0.1" Value="2.0" ValueChanged="OnZoomSliderChanged" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row Splitter -->
        <toolkit:GridSplitter Grid.Row="1" Background="Transparent" VerticalAlignment="Stretch" />

        <!-- BOTTOM PANEL: Timeline -->
        <Grid Grid.Row="2" Background="#1A1A1E" Margin="10,5,10,10" CornerRadius="8" BorderThickness="1" BorderBrush="#2D2D32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Timeline Toolbar -->
            <Grid Grid.Row="0" Padding="15,10,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="Timeline Editor" FontWeight="Bold" FontSize="15" Foreground="#E1E1E6" VerticalAlignment="Center" />
                    <Button Content="Undo" FontSize="12" Click="OnUndoClick" Background="#28282C" BorderBrush="#3E3E44" Foreground="#E1E1E6" />
                    <Button Content="Redo" FontSize="12" Click="OnRedoClick" Background="#28282C" BorderBrush="#3E3E44" Foreground="#E1E1E6" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="FFIStatusText" Text="Rust FFI: Loaded" FontSize="11" Foreground="#00E676" VerticalAlignment="Center" />
            </Grid>

            <!-- Timeline Scroll Viewport -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#141416" Margin="10,5,10,10" CornerRadius="6">
                <controls:TimelineCanvas x:Name="TimelineEditor" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
